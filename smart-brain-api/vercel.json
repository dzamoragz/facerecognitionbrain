{
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/register", "destination": "/api/register" },
    { "source": "/signin", "destination": "/api/signin" },
    { "source": "/profile/:id", "destination": "/api/profile/:id" },
    { "source": "/image", "destination": "/api/image" },
    { "source": "/imageurl", "destination": "/api/imageurl" }
  ]
}
